HOST=0.0.0.0
PORT=12600
BASE_URL=/
NODE_OPTIONS=--openssl-legacy-provider

# SMB share, for example: //192.168.1.10/Public or \\192.168.1.10\Public
SMB_SHARE=//nas.example.com/share
SMB_DOMAIN=WORKGROUP
SMB_ROOT=/

# Upload chunks are written here before being merged and copied into SMB.
# In Docker, map this path to a persistent NAS/disk directory.
UPLOAD_TEMP_DIR=/data/uploads-temp
UPLOAD_CHUNK_SIZE=8388608
UPLOAD_MAX_BODY_BYTES=16777216
SHARE_TOKEN_TTL_SECONDS=86400
